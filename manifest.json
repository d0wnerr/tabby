{
  "manifest_version": 3,
  "name": "Tabby",
  "version": "1.0",
  "description": "Suspend tabs opened at startup",
  "permissions": [
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "assets/16.png",
      "32": "assets/32.png",
      "48": "assets/48.png",
      "128": "assets/128.png"
    },
    "default_title": "Tabby",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "assets/16.png",
    "32": "assets/32.png",
    "48": "assets/48.png",
    "128": "assets/128.png"
  }
}
